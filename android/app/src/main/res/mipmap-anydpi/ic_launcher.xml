<?xml version="1.0" encoding="utf-8"?>
<!-- The logo comes from branding/logo.png (copied in at build time). The inset keeps it inside the icon's safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background"/>
    <foreground>
        <inset android:drawable="@drawable/brand_logo" android:inset="20%"/>
    </foreground>
</adaptive-icon>
